# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / web
node_modules/
web/dist/
*.tsbuildinfo

# Rust / Tauri
target/

# Runtime data must never be committed. The real storage root lives under
# ~/Library/Application Support/Watchpost/, but guard against local overrides.
data/
*.db
*.db-wal
*.db-shm
token
clips/
thumbs/
ring/
logs/
*.mp4
# MPEG-TS ring segments only — never plain *.ts, which would swallow TypeScript sources.
ring/*.ts

# Lockfiles (server/uv.lock, web/bun.lock, src-tauri/Cargo.lock) and .python-version are
# deliberately committed: this is an application, not a library, and CI installs with
# --frozen-lockfile / --locked so builds are reproducible.

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watchpost",
  "version": "0.1.0",
  "identifier": "dev.watchpost.app",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Watchpost",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
